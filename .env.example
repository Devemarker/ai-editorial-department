# AI 编辑部智能体编排系统 - 环境变量配置

# 服务配置
PORT=3000

# LLM Provider 选择（openai 或 minimax）
LLM_PROVIDER=openai

# OpenAI API 配置
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o

# MiniMax API 配置（当 LLM_PROVIDER=minimax 时使用）
# MINIMAX_API_KEY=your_api_key_here
# MINIMAX_GROUP_ID=your_group_id_here
# MINIMAX_MODEL=abab5.5-chat

# LLM 默认配置
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=2048

# 数据库配置
DB_PATH=./data/ai-editorial.db

# ChromaDB 配置
# ChromaDB 可以使用以下模式之一：
# 1. 嵌入式模式（无需外部服务）- 默认：
# CHROMA_PATH=./data/chroma

# 2. HTTP 客户端模式（需要 ChromaDB 服务运行在 localhost:8000）：
CHROMA_PATH=http://localhost:8000
