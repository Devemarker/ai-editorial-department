# AI 编辑部智能体编排系统 - 环境变量配置

# 服务配置
PORT=3000

# OpenAI API 配置（必填）
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o

# 数据库配置
DB_PATH=./data/ai-editorial.db

# ChromaDB 配置
# ChromaDB 可以使用以下模式之一：
# 1. 嵌入式模式（无需外部服务）- 默认：
# CHROMA_PATH=./data/chroma

# 2. HTTP 客户端模式（需要 ChromaDB 服务运行在 localhost:8000）：
CHROMA_PATH=http://localhost:8000
